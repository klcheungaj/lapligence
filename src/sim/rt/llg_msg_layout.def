/* llg_msg_layout.def: the layout of every llg message, the single source
 * that the host renderer (Rust, src/core/report.rs) and the model runtime
 * renderer (C, llg_msg.h) both read. Changing the layout is an edit here plus
 * regenerated expectations (docs/messages.md).
 *
 * Each entry is LLG_MSG_LAYOUT(NAME, "value"); values are C string literals
 * using only \" and \\ escapes.
 *
 * TEMPLATE fields: {severity} (one of the severity words below), {location}
 * (file:line:col, with a `line-mapped suffix when one applies), {id}
 * (TOOL ID_JOIN index), {context} (design scope and simulation time, joined by
 * CONTEXT_JOIN), {text} (the message; user text is never changed) and {hint}
 * (how to select the message: a lint rule name or a frontend warning option).
 * <...> is an optional group, left out whole when a field inside it is empty;
 * groups do not nest. Fields after {text} are not recovered by parsers.
 *
 * SUMMARY is the text of the per-phase count message (index 000 of a tool),
 * with the counts {fatal}, {error}, {warning} and {info}; {fatal} and {info}
 * are empty when zero. */
LLG_MSG_LAYOUT(TEMPLATE, "{severity}: <{location}: >[{id}] <({context}) >{text}< ({hint})>")
LLG_MSG_LAYOUT(SEVERITY_FATAL, "FATAL")
LLG_MSG_LAYOUT(SEVERITY_ERROR, "ERROR")
LLG_MSG_LAYOUT(SEVERITY_WARNING, "WARNING")
LLG_MSG_LAYOUT(SEVERITY_INFO, "INFO")
LLG_MSG_LAYOUT(ID_JOIN, "-")
LLG_MSG_LAYOUT(CONTEXT_JOIN, " @ ")
LLG_MSG_LAYOUT(SUMMARY, "<{fatal} fatal, >{error} error(s), {warning} warning(s)<, {info} info(s)>")
