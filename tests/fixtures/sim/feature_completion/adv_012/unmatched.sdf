(DELAYFILE
 (SDFVERSION "3.0")
 (DESIGN "tb")
 (TIMESCALE 1ns)
 (CELL (CELLTYPE "BUF") (INSTANCE nosuch) (DELAY (ABSOLUTE (IOPATH a y (9)))))
 (CELL (CELLTYPE "FF") (INSTANCE u0) (DELAY (ABSOLUTE (IOPATH a y (9)))))
 (CELL (CELLTYPE "BUF") (INSTANCE u0)
  (DELAY (ABSOLUTE (IOPATH b y (9)) (IOPATH a y (2)))))
 (CELL (CELLTYPE "FF") (INSTANCE f0)
  (TIMINGCHECK (HOLD d (posedge clk) (5)) (SETUP d (posedge clk) (4))))
 (CELL (CELLTYPE "NONE") (INSTANCE *) (DELAY (ABSOLUTE (IOPATH a y (1)))))
)
