(DELAYFILE
 (SDFVERSION "3.0")
 (TIMESCALE 1ns)
 (CELL (CELLTYPE "SU") (INSTANCE su) (TIMINGCHECK (SETUP d (posedge clk) (6))))
 (CELL (CELLTYPE "HO") (INSTANCE ho) (TIMINGCHECK (HOLD d (posedge clk) (6))))
 (CELL (CELLTYPE "SH") (INSTANCE sh) (TIMINGCHECK (SETUPHOLD d (posedge clk) (6) (6))))
 (CELL (CELLTYPE "RC") (INSTANCE rc)
  (TIMINGCHECK (RECOVERY (posedge rst) (posedge clk) (7))))
 (CELL (CELLTYPE "RM") (INSTANCE rm)
  (TIMINGCHECK (REMOVAL (posedge rst) (posedge clk) (8))))
 (CELL (CELLTYPE "RR") (INSTANCE rr)
  (TIMINGCHECK (RECREM (posedge rst) (posedge clk) (7) (8))))
 (CELL (CELLTYPE "SK") (INSTANCE sk) (TIMINGCHECK (SKEW (posedge clk) (posedge d) (3))))
 (CELL (CELLTYPE "WI") (INSTANCE wi) (TIMINGCHECK (WIDTH (posedge clk) (12))))
 (CELL (CELLTYPE "PE") (INSTANCE pe) (TIMINGCHECK (PERIOD (posedge clk) (40))))
 (CELL (CELLTYPE "NC") (INSTANCE nc) (TIMINGCHECK (NOCHANGE (posedge clk) d (2) (3))))
)
