# Check text out with LF on every host. Tests compare fixtures, goldens and
# source prefixes byte for byte, and Windows runners default to
# core.autocrlf=true, which would rewrite them with CRLF.
* text=auto eol=lf
*.patch text eol=lf
patches/**/*.sha256 text eol=lf
# Unified diff payloads can require whitespace-only context lines.
patches/slang/*.patch whitespace=-blank-at-eol
patches/libfst/*.patch whitespace=-blank-at-eol
