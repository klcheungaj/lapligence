@@ -1832,6 +1829,15 @@ const Expression* PortConnection::getExpression() const {
         if (!connectedSymbol) {
             if (port.kind == SymbolKind::MultiPort)
                 expr = &Expression::bind(*exprSyntax, context);
+            else if (direction == ArgumentDirection::Ref) {
+                // Module ref ports admit the same packed lvalue selections as
+                // other variable reference connections.  Subroutine ref
+                // arguments retain their separate 2009 restriction because
