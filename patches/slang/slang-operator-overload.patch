+// ---- Operator overloading (IEEE 1800-2009 11.11) ----
+
+// The formal count each overload_operator admits: `+` and `-` are unary or binary,
+// increment, decrement and assignment are unary, and the rest are binary.
+static bool isValidOverloadArity(TokenKind op, size_t arity) {
+    switch (op) {
+        case TokenKind::Plus:
+        case TokenKind::Minus:
+            return arity == 1 || arity == 2;
+        case TokenKind::DoublePlus:
+        case TokenKind::DoubleMinus:
+        case TokenKind::Equals:
+            return arity == 1;
+        default:
+            return arity == 2;
+    }
+}
+
+OperatorOverloadSymbol& OperatorOverloadSymbol::fromSyntax(
+    const Scope& scope, const OverloadDeclarationSyntax& syntax) {
+    auto& comp = scope.getCompilation();
+    auto result = comp.emplace<OperatorOverloadSymbol>(syntax.op.kind, syntax.name.valueText(),
+                                                       syntax.name.location());
+    result->setSyntax(syntax);
+    result->setAttributes(scope, syntax.attributes);
+
+    if (!isValidOverloadArity(syntax.op.kind, syntax.args.size()))
+        scope.addDiag(diag::OverloadArity, syntax.op.range())
+            << syntax.op.valueText() << syntax.args.size();
+
+    return *result;
+}
+
+size_t OperatorOverloadSymbol::getArity() const {
+    auto syntax = getSyntax();
+    SLANG_ASSERT(syntax);
+    return syntax->as<OverloadDeclarationSyntax>().args.size();
+}
+
+const Type& OperatorOverloadSymbol::getReturnType() const {
+    if (!returnType) {
+        auto scope = getParentScope();
+        auto syntax = getSyntax();
+        SLANG_ASSERT(scope && syntax);
+
+        // Prototype types follow data declaration rules in the declaring scope.
+        ASTContext context(*scope, LookupLocation::before(*this));
+        returnType = &scope->getCompilation().getType(
+            *syntax->as<OverloadDeclarationSyntax>().returnType, context);
+    }
+    return *returnType;
+}
+
+std::span<const Type* const> OperatorOverloadSymbol::getFormalTypes() const {
+    if (!formalTypes) {
+        auto scope = getParentScope();
+        auto syntax = getSyntax();
+        SLANG_ASSERT(scope && syntax);
+
+        auto& comp = scope->getCompilation();
+        ASTContext context(*scope, LookupLocation::before(*this));
+        SmallVector<const Type*> types;
+        for (auto arg : syntax->as<OverloadDeclarationSyntax>().args)
+            types.push_back(&comp.getType(*arg, context));
+        formalTypes = types.copy(comp);
+    }
+    return *formalTypes;
+}
+
+void OperatorOverloadSymbol::serializeTo(ASTSerializer& serializer) const {
+    serializer.write("op", LexerFacts::getTokenKindText(op));
+    serializer.write("function", functionName);
+    serializer.write("returnType", getReturnType());
+    serializer.startArray("formalTypes");
+    for (auto type : getFormalTypes())
+        serializer.serialize(*type);
+    serializer.endArray();
+}
+
+namespace {
+
+enum class OverloadArgMatch { None, Exact, Integral };
+
+// Prototype formals normally match the operand types exactly; an integral
+// operand may also reach an integral formal through the normal implicit cast.
+OverloadArgMatch matchOverloadArgs(const OperatorOverloadSymbol& proto,
+                                   std::span<const Type* const> actualTypes) {
+    auto formals = proto.getFormalTypes();
+    SLANG_ASSERT(formals.size() == actualTypes.size());
+
+    auto result = OverloadArgMatch::Exact;
+    for (size_t i = 0; i < formals.size(); i++) {
+        auto& formal = *formals[i];
+        auto& actual = *actualTypes[i];
+        if (formal.isError() || actual.isError())
+            return OverloadArgMatch::None;
+        if (formal.isMatching(actual))
+            continue;
+        if (formal.isIntegral() && actual.isIntegral()) {
+            result = OverloadArgMatch::Integral;
+            continue;
+        }
+        return OverloadArgMatch::None;
+    }
+    return result;
+}
+
+bool sameFormals(const OperatorOverloadSymbol& a, const OperatorOverloadSymbol& b) {
+    auto af = a.getFormalTypes();
+    auto bf = b.getFormalTypes();
+    for (size_t i = 0; i < af.size(); i++) {
+        if (!af[i]->isMatching(*bf[i]))
+            return false;
+    }
+    return true;
+}
+
+enum class OverloadResult { NotFound, Found, Error };
+
+// Selects among the prototypes visible in one scope. Exact argument matches win;
+// otherwise the integral exception applies only when every candidate shares a
+// single formal signature. Prototypes that differ only in their result type are
+// told apart by the expected type, which must then be unique.
+OverloadResult selectOverload(const ASTContext& context,
+                              std::span<const OperatorOverloadSymbol* const> visible,
+                              std::span<const Type* const> actualTypes, const Type* expectedType,
+                              TokenKind op, SourceRange opRange,
+                              const OperatorOverloadSymbol*& selected) {
+    SmallVector<const OperatorOverloadSymbol*> exact;
+    SmallVector<const OperatorOverloadSymbol*> integral;
+    for (auto proto : visible) {
+        switch (matchOverloadArgs(*proto, actualTypes)) {
+            case OverloadArgMatch::Exact:
+                exact.push_back(proto);
+                break;
+            case OverloadArgMatch::Integral:
+                integral.push_back(proto);
+                break;
+            case OverloadArgMatch::None:
+                break;
+        }
+    }
+
+    auto& candidates = exact.empty() ? integral : exact;
+    if (candidates.empty())
+        return OverloadResult::NotFound;
+
+    if (exact.empty()) {
+        for (auto proto : candidates) {
+            if (!sameFormals(*proto, *candidates[0]))
+                return OverloadResult::NotFound;
+        }
+    }
+
+    if (candidates.size() == 1) {
+        selected = candidates[0];
+        return OverloadResult::Found;
+    }
+
+    if (expectedType) {
+        const OperatorOverloadSymbol* byResult = nullptr;
+        size_t count = 0;
+        for (auto proto : candidates) {
+            if (proto->getReturnType().isMatching(*expectedType)) {
+                byResult = proto;
+                count++;
+            }
+        }
+        if (count == 1) {
+            selected = byResult;
+            return OverloadResult::Found;
+        }
+    }
+
+    auto& diag = context.addDiag(diag::OverloadAmbiguous, opRange);
+    diag << LexerFacts::getTokenKindText(op);
+    for (auto proto : candidates)
+        diag.addNote(diag::NoteDeclarationHere, proto->location);
+    return OverloadResult::Error;
+}
+
+// Walks the lexical scopes of the use outward. Prototypes are visible once
+// declared, like data declarations; the innermost scope with a matching
+// prototype decides, so an inner declaration shadows an outer one.
+OverloadResult findOverload(const ASTContext& context, TokenKind op,
+                            std::span<const Type* const> actualTypes, const Type* expectedType,
+                            SourceRange opRange, const OperatorOverloadSymbol*& selected) {
+    const Scope* scope = context.scope;
+    LookupLocation location = context.getLocation();
+    SmallVector<const OperatorOverloadSymbol*> visible;
+    while (scope) {
+        visible.clear();
+        for (auto& proto : scope->membersOfType<OperatorOverloadSymbol>()) {
+            if (proto.op != op || proto.getArity() != actualTypes.size())
+                continue;
+            if (location.getScope() == scope && LookupLocation::before(proto) >= location)
+                continue;
+            visible.push_back(&proto);
+        }
+
+        if (!visible.empty()) {
+            auto result = selectOverload(context, visible, actualTypes, expectedType, op, opRange,
+                                         selected);
+            if (result != OverloadResult::NotFound)
+                return result;
+        }
+
+        location = LookupLocation::after(scope->asSymbol());
+        scope = location.getScope();
+    }
+    return OverloadResult::NotFound;
+}
+
+// The bound function is found with the scope search rules of a call made where
+// the operator is used, and must agree with its prototype.
+const SubroutineSymbol* findOverloadFunction(const ASTContext& context,
+                                             const OperatorOverloadSymbol& proto,
+                                             SourceRange opRange) {
+    auto symbol = Lookup::unqualified(*context.scope, proto.functionName);
+    if (!symbol || symbol->kind != SymbolKind::Subroutine) {
+        auto& diag = context.addDiag(diag::OverloadFunctionNotFound, opRange);
+        diag << proto.functionName;
+        diag.addNote(diag::NoteDeclarationHere, proto.location);
+        return nullptr;
+    }
+
+    auto& fn = symbol->as<SubroutineSymbol>();
+    auto formals = proto.getFormalTypes();
+    auto args = fn.getArguments();
+    bool ok = fn.subroutineKind == SubroutineKind::Function && !fn.thisVar &&
+              args.size() == formals.size() &&
+              fn.getReturnType().isMatching(proto.getReturnType());
+    for (size_t i = 0; ok && i < args.size(); i++) {
+        ok = args[i]->direction == ArgumentDirection::In &&
+             args[i]->getType().isMatching(*formals[i]);
+    }
+
+    if (!ok) {
+        auto& diag = context.addDiag(diag::OverloadPrototypeMismatch, opRange);
+        diag << fn.name;
+        diag.addNote(diag::NoteDeclarationHere, proto.location);
+        diag.addNote(diag::NoteDeclarationHere, fn.location);
+        return nullptr;
+    }
+    return &fn;
+}
+
+// Calls, assignments and increments would run twice once an overloaded update
+// reads its target separately from writing it.
+bool overloadTargetHasSideEffects(const Expression& expr) {
+    bool found = false;
+    auto visitor = makeVisitor([&](auto&, const CallExpression&) { found = true; },
+                               [&](auto&, const AssignmentExpression&) { found = true; },
+                               [&](auto& visitor, const UnaryExpression& unary) {
+                                   if (unary.op == UnaryOperator::Preincrement ||
+                                       unary.op == UnaryOperator::Predecrement ||
+                                       unary.op == UnaryOperator::Postincrement ||
+                                       unary.op == UnaryOperator::Postdecrement) {
+                                       found = true;
+                                   }
+                                   else {
+                                       visitor.visitDefault(unary);
+                                   }
+                               });
+    expr.visit(visitor);
+    return found;
+}
+
