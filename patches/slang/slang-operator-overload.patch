+                              std::span<const OperatorOverloadSymbol* const> visible,
+                              std::span<const Type* const> actualTypes, const Type* expectedType,
+                              TokenKind op, SourceRange opRange, bool deferAmbiguity,
+                              const OperatorOverloadSymbol*& selected) {
+    SmallVector<const OperatorOverloadSymbol*> exact;
+    SmallVector<const OperatorOverloadSymbol*> integral;
+    for (auto proto : visible) {
+        switch (matchOverloadArgs(*proto, actualTypes)) {
+            case OverloadArgMatch::Exact:
+                exact.push_back(proto);
+                break;
+            case OverloadArgMatch::Integral:
+                integral.push_back(proto);
+                break;
+            case OverloadArgMatch::None:
+                break;
+        }
+    }
+
+    auto& candidates = exact.empty() ? integral : exact;
+    if (candidates.empty())
+        return OverloadResult::NotFound;
+
+    if (exact.empty()) {
+        for (auto proto : candidates) {
+            if (!sameFormals(*proto, *candidates[0]))
+                return OverloadResult::NotFound;
+        }
+    }
+
+    if (candidates.size() == 1) {
+        selected = candidates[0];
+        return OverloadResult::Found;
+    }
+
+    if (expectedType) {
+        const OperatorOverloadSymbol* byResult = nullptr;
+        size_t count = 0;
+        for (auto proto : candidates) {
+            if (proto->getReturnType().isMatching(*expectedType)) {
+                byResult = proto;
+                count++;
+            }
+        }
+        if (count == 1) {
+            selected = byResult;
+            return OverloadResult::Found;
+        }
+    }
+
+    if (deferAmbiguity && !expectedType)
+        return OverloadResult::Deferred;
+
+    auto& diag = context.addDiag(diag::OverloadAmbiguous, opRange);
+    diag << LexerFacts::getTokenKindText(op);
+    for (auto proto : candidates)
+        diag.addNote(diag::NoteDeclarationHere, proto->location);
+    return OverloadResult::Error;
+}
+
+// Walks the lexical scopes of the use outward. Prototypes are visible once
+// declared, like data declarations; the innermost scope with a matching
+// prototype decides, so an inner declaration shadows an outer one.
+//
+// Within one scope, the scope's own prototypes come first, then those declared
+// directly in packages that the scope wildcard-imports before the use (IEEE
+// 1800-2009 11.11 gives overloads the search rules of a data declaration, and
+// 26.3 makes a wildcard import a fallback after local declarations). An
+// overload declaration has no name, so an explicit import or an export never
+// carries it.
+OverloadResult findOverload(const ASTContext& context, TokenKind op,
+                            std::span<const Type* const> actualTypes, const Type* expectedType,
+                            SourceRange opRange, bool deferAmbiguity,
+                            const OperatorOverloadSymbol*& selected) {
+    const Scope* scope = context.scope;
+    LookupLocation location = context.getLocation();
+    SmallVector<const OperatorOverloadSymbol*> visible;
+    auto collect = [&](const Scope& declaring) {
+        for (auto& proto : declaring.membersOfType<OperatorOverloadSymbol>()) {
+            if (proto.op != op || proto.getArity() != actualTypes.size())
+                continue;
+            if (location.getScope() == &declaring && LookupLocation::before(proto) >= location)
+                continue;
+            visible.push_back(&proto);
+        }
+    };
+    auto select = [&]() {
+        if (visible.empty())
+            return OverloadResult::NotFound;
+        return selectOverload(context, visible, actualTypes, expectedType, op, opRange,
+                              deferAmbiguity, selected);
+    };
+
+    while (scope) {
+        visible.clear();
+        collect(*scope);
+        if (auto result = select(); result != OverloadResult::NotFound)
+            return result;
+
+        if (auto importData = scope->getWildcardImportData()) {
+            visible.clear();
+            for (auto import : importData->wildcardImports) {
+                if (import->isFromExport)
+                    continue;
+                if (location.getScope() == scope && LookupLocation::before(*import) >= location)
+                    continue;
+                if (auto package = import->getPackage())
+                    collect(*package);
+            }
+            if (auto result = select(); result != OverloadResult::NotFound)
+                return result;
+        }
+
+        location = LookupLocation::after(scope->asSymbol());
+        scope = location.getScope();
+    }
+    return OverloadResult::NotFound;
+}
+
+// The bound function is found with the scope search rules of a call made where
+// the operator is used, and must agree with its prototype.
+const SubroutineSymbol* findOverloadFunction(const ASTContext& context,
+                                             const OperatorOverloadSymbol& proto,
+                                             SourceRange opRange) {
+    auto symbol = Lookup::unqualified(*context.scope, proto.functionName);
+    if (!symbol || symbol->kind != SymbolKind::Subroutine) {
+        auto& diag = context.addDiag(diag::OverloadFunctionNotFound, opRange);
+        diag << proto.functionName;
+        diag.addNote(diag::NoteDeclarationHere, proto.location);
+        return nullptr;
+    }
+
+    auto& fn = symbol->as<SubroutineSymbol>();
+    auto formals = proto.getFormalTypes();
+    auto args = fn.getArguments();
+    bool ok = fn.subroutineKind == SubroutineKind::Function && !fn.thisVar &&
+              args.size() == formals.size() &&
+              fn.getReturnType().isMatching(proto.getReturnType());
+    for (size_t i = 0; ok && i < args.size(); i++) {
+        ok = args[i]->direction == ArgumentDirection::In &&
+             args[i]->getType().isMatching(*formals[i]);
+    }
+
+    if (!ok) {
+        auto& diag = context.addDiag(diag::OverloadPrototypeMismatch, opRange);
+        diag << fn.name;
+        diag.addNote(diag::NoteDeclarationHere, proto.location);
+        diag.addNote(diag::NoteDeclarationHere, fn.location);
+        return nullptr;
+    }
+    return &fn;
+}
+
+// Calls, assignments and increments would run twice once an overloaded update
+// reads its target separately from writing it.
+bool overloadTargetHasSideEffects(const Expression& expr) {
+    bool found = false;
+    auto visitor = makeVisitor([&](auto&, const CallExpression&) { found = true; },
+                               [&](auto&, const AssignmentExpression&) { found = true; },
+                               [&](auto& visitor, const UnaryExpression& unary) {
+                                   if (unary.op == UnaryOperator::Preincrement ||
+                                       unary.op == UnaryOperator::Predecrement ||
+                                       unary.op == UnaryOperator::Postincrement ||
+                                       unary.op == UnaryOperator::Postdecrement) {
+                                       found = true;
+                                   }
+                                   else {
+                                       visitor.visitDefault(unary);
+                                   }
+                               });
+    expr.visit(visitor);
+    return found;
+}
+
+} // namespace
+
+Expression* CallExpression::tryOverloadedOperator(const ASTContext& context, TokenKind op,
+                                                  std::span<Expression* const> operands,
+                                                  const Type* expectedType,
+                                                  SourceRange sourceRange, SourceRange opRange) {
+    auto& comp = context.getCompilation();
+    if (!comp.hasOperatorOverloads())
+        return nullptr;
+
+    SmallVector<const Type*, 2> actualTypes;
+    for (auto operand : operands) {
+        if (operand->bad())
+            return nullptr;
+        actualTypes.push_back(operand->type);
+    }
+
+    // Only the operand a relational operator is probing may wait for its type.
+    auto probe = comp.overloadAmbiguityProbe;
+    const bool deferAmbiguity = probe && probe->operand == sourceRange;
+
+    const OperatorOverloadSymbol* proto = nullptr;
+    switch (findOverload(context, op, actualTypes, expectedType, opRange, deferAmbiguity,
+                         proto)) {
+        case OverloadResult::NotFound:
+            return nullptr;
+        case OverloadResult::Deferred:
+            probe->deferred = true;
+            return &badExpr(comp, nullptr);
+        case OverloadResult::Error:
+            return &badExpr(comp, nullptr);
+        case OverloadResult::Found:
+            break;
+    }
+
+    auto fn = findOverloadFunction(context, *proto, opRange);
+    if (!fn)
+        return &badExpr(comp, nullptr);
+
+    // Operands bind to the function's input formals exactly like call arguments.
+    comp.noteReference(*fn);
+    auto formals = fn->getArguments();
+    SmallVector<const Expression*, 2> args;
+    bool bad = false;
+    for (size_t i = 0; i < operands.size(); i++) {
+        auto& arg = Expression::convertAssignment(context, formals[i]->getType(), *operands[i],
+                                                  operands[i]->sourceRange);
+        bad |= arg.bad();
+        args.push_back(&arg);
+    }
+
+    auto result = comp.emplace<CallExpression>(fn, fn->getReturnType(), nullptr, args.copy(comp),
+                                               context.getLocation(), sourceRange);
+    if (bad)
+        return &badExpr(comp, result);
+    return result;
+}
+
+Expression* CallExpression::tryOverloadedIncDec(const ASTContext& context, TokenKind op,
+                                                bool isPostfix, Expression& target,
+                                                SourceRange sourceRange, SourceRange opRange) {
+    auto& comp = context.getCompilation();
+    if (!comp.hasOperatorOverloads() || target.bad())
+        return nullptr;
+
+    const Type* actualTypes[] = {target.type};
+    const OperatorOverloadSymbol* proto = nullptr;
+    switch (findOverload(context, op, actualTypes, target.type, opRange,
+                         /* deferAmbiguity */ false, proto)) {
+        case OverloadResult::NotFound:
+            return nullptr;
+        case OverloadResult::Deferred:
+        case OverloadResult::Error:
+            return &badExpr(comp, nullptr);
+        case OverloadResult::Found:
+            break;
+    }
+
+    // The bound function reads the target's current value through the same
+    // placeholder a compound assignment uses, so the target is bound once.
+    auto current = comp.emplace<LValueReferenceExpression>(*target.type, target.sourceRange);
+    Expression* operands[] = {current};
+    auto call = tryOverloadedOperator(context, op, operands, target.type, sourceRange, opRange);
+    if (!call)
+        return &badExpr(comp, nullptr);
+    if (call->bad())
+        return call;
+
+    auto& update = finishOverloadedCompound(context, call->as<CallExpression>(), target);
+    auto& rhs = Expression::convertAssignment(context, *target.type, update, opRange);
+    std::optional<BinaryOperator> compound;
+    if (isOverloadedCompound(update)) {
+        compound = op == TokenKind::DoublePlus ? BinaryOperator::Add : BinaryOperator::Subtract;
+    }
+    auto result = comp.emplace<AssignmentExpression>(compound, /* nonBlocking */ false,
+                                                     *target.type, target, rhs, nullptr,
+                                                     sourceRange);
+    result->isOverloadedPostfix = compound.has_value() && isPostfix;
+    if (rhs.bad())
+        return &badExpr(comp, result);
+    return result;
+}
+
+Expression* CallExpression::tryOverloadedConversion(const ASTContext& context,
+                                                    const Type& targetType, Expression& expr,
+                                                    SourceRange sourceRange) {
+    auto& comp = context.getCompilation();
+    if (!comp.hasOperatorOverloads() || expr.bad())
+        return nullptr;
+
+    const Type* actualTypes[] = {expr.type};
+    const OperatorOverloadSymbol* proto = nullptr;
+    switch (findOverload(context, TokenKind::Equals, actualTypes, &targetType, sourceRange,
+                         /* deferAmbiguity */ false, proto)) {
+        case OverloadResult::NotFound:
+            return nullptr;
+        case OverloadResult::Deferred:
+        case OverloadResult::Error:
+            return &badExpr(comp, nullptr);
+        case OverloadResult::Found:
+            break;
+    }
+
+    // The result itself must then be assignable without another overload, which
+    // also bounds the conversion to a single function call.
+    auto& resultType = proto->getReturnType();
+    if (!targetType.isEquivalent(resultType) && !targetType.isAssignmentCompatible(resultType))
+        return nullptr;
+
+    Expression* operands[] = {&expr};
+    return tryOverloadedOperator(context, TokenKind::Equals, operands, &targetType,
+                                 expr.sourceRange, sourceRange);
+}
+
+bool CallExpression::isOverloadedCompound(const Expression& expr) {
+    if (expr.kind != ExpressionKind::Call)
+        return false;
+
+    auto& call = expr.as<CallExpression>();
+    if (call.isSystemCall() || call.arguments().empty())
+        return false;
+    return call.arguments()[0]->unwrapImplicitConversions().kind ==
+           ExpressionKind::LValueReference;
+}
+
+Expression& CallExpression::finishOverloadedCompound(const ASTContext& context,
+                                                     CallExpression& call,
+                                                     const Expression& lhs) {
+    // In statement position a target without side effects may simply be read
+    // again, giving `A = f(A, B)`; this keeps the ordinary assignment forms,
+    // including descriptor-sized and native targets. Otherwise the placeholder
+    // stays, so the target is evaluated once and the expression's value (the
+    // assigned value, or the old value of a postfix form) stays available.
+    if (!context.flags.has(ASTFlags::TopLevelStatement) || overloadTargetHasSideEffects(lhs) ||
+        !lhs.syntax || !ExpressionSyntax::isKind(lhs.syntax->kind)) {
+        return call;
+    }
+
+    auto& comp = context.getCompilation();
+    auto& fn = *std::get<0>(call.subroutine);
+    auto& read = create(comp, lhs.syntax->as<ExpressionSyntax>(), context);
+    auto& arg = Expression::convertAssignment(context, fn.getArguments()[0]->getType(), read,
+                                              read.sourceRange);
+    call.arguments()[0] = &arg;
+    if (arg.bad())
+        return badExpr(comp, &call);
+    return call;
+}
+
 } // namespace slang::ast
