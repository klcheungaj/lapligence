+OverloadDeclarationSyntax& Parser::parseOverloadDeclaration(AttrList attributes) {
+    auto bindKeyword = consume();
+    auto op = consume();
+    auto functionKeyword = expect(TokenKind::FunctionKeyword);
+    auto& returnType = parseDataType();
+    auto name = expect(TokenKind::Identifier);
+    auto openParen = expect(TokenKind::OpenParenthesis);
+
+    SmallVector<TokenOrSyntax, 4> buffer;
+    while (true) {
+        buffer.push_back(&parseDataType());
+        if (!peek(TokenKind::Comma))
+            break;
+        buffer.push_back(consume());
+    }
+
+    auto closeParen = expect(TokenKind::CloseParenthesis);
+    auto semi = expect(TokenKind::Semicolon);
+    return factory.overloadDeclaration(attributes, bindKeyword, op, functionKeyword, returnType,
+                                       name, openParen, {alloc, buffer}, closeParen, semi);
+}
