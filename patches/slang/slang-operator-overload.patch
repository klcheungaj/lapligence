+/// Represents an operator overload declaration (IEEE 1800-2009 11.11):
+/// `bind <op> function <type> <name>(<types>);`. It is unnamed so it never
+/// conflicts with the bound function; resolution walks the lexical scopes
+/// of an operator use and honors declaration-before-use like a data declaration.
+/// The implementation lives with overload resolution in CallExpression.cpp.
+class SLANG_EXPORT OperatorOverloadSymbol final : public Symbol {
+public:
+    /// The overload_operator token kind.
+    parsing::TokenKind op;
+
+    /// The name of the bound function, looked up from each invocation scope.
+    std::string_view functionName;
+
+    OperatorOverloadSymbol(parsing::TokenKind op, std::string_view functionName,
+                           SourceLocation loc) :
+        Symbol(SymbolKind::OperatorOverload, ""sv, loc), op(op), functionName(functionName) {}
+
+    /// The prototype's result type, resolved in the declaring scope.
+    const Type& getReturnType() const;
+
+    /// The prototype's formal types, resolved in the declaring scope.
+    std::span<const Type* const> getFormalTypes() const;
+
+    /// The number of prototype formals, available without resolving types.
+    size_t getArity() const;
+
+    static OperatorOverloadSymbol& fromSyntax(const Scope& scope,
+                                              const syntax::OverloadDeclarationSyntax& syntax);
+
+    void serializeTo(ASTSerializer& serializer) const;
+
+    static bool isKind(SymbolKind kind) { return kind == SymbolKind::OperatorOverload; }
+
+private:
+    mutable const Type* returnType = nullptr;
+    mutable std::optional<std::span<const Type* const>> formalTypes;
+};
