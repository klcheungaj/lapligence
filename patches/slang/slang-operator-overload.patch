+bool SyntaxFacts::isOverloadOperator(TokenKind kind) {
+    switch (kind) {
+        case TokenKind::Plus:
+        case TokenKind::DoublePlus:
+        case TokenKind::Minus:
+        case TokenKind::DoubleMinus:
+        case TokenKind::Star:
