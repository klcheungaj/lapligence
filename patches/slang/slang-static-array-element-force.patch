+// Whether SystemVerilog force and release admit an element of a static
+// unpacked array variable as a target. 1800-2009 10.6.2 admits "a singular
+// variable"; such an element is one (6.4), and so is a member of an unpacked
+// structure reached from it. IEEE 1364-2001 9.3.2 excludes every memory word.
+static bool forceAdmitsArrayElements(const ASTContext& context) {
+    return context.getCompilation().languageVersion() >= LanguageVersion::v1800_2017;
+}
+
+// A chain of element selects of fixed-size unpacked arrays and member
+// accesses of unpacked structures, with at least one element select, rooted
+// at a variable: `mem[i]`, `mem2[i][j]`, `s[i].f`. Elements of dynamic arrays,
+// queues and associative arrays, class properties, and bit- or part-selects
+// of an element (selects of a variable) are not such chains.
+static bool isStaticArrayElementLVal(const Expression& expr) {
+    bool element = false;
+    const Expression* current = &expr;
+    while (true) {
+        switch (current->kind) {
+            case ExpressionKind::ElementSelect: {
+                auto& value = current->as<ElementSelectExpression>().value();
+                if (value.type->getCanonicalType().kind != SymbolKind::FixedSizeUnpackedArrayType)
+                    return false;
+                element = true;
+                current = &value;
+                break;
+            }
+            case ExpressionKind::MemberAccess: {
+                auto& value = current->as<MemberAccessExpression>().value();
+                if (!value.type->isUnpackedStruct())
+                    return false;
+                current = &value;
+                break;
+            }
+            case ExpressionKind::NamedValue:
+            case ExpressionKind::HierarchicalValue: {
+                auto sym = current->getSymbolReference();
+                return element && sym && sym->kind == SymbolKind::Variable;
+            }
+            default:
+                return false;
+        }
+    }
+}
