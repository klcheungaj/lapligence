+TEST_CASE("Force and release of static unpacked array elements") {
+    // An element of a static unpacked array variable, or a member of an
+    // unpacked structure element, is a singular variable (IEEE 1800-2009 6.4,
+    // 10.6.2); its index may be a runtime expression. Selects of an element,
+    // dynamic array and queue elements, and runtime net selects stay illegal.
+    auto tree = SyntaxTree::fromText(R"(
+typedef struct { int f; int g; } s_t;
+module m;
+    int mem[4];
+    int mem2[2][3];
+    s_t s[2];
+    logic [7:0] bytes[2];
+    int dq[];
+    int q[$];
+    wire [3:0] nets[2];
+    int i;
+
+    initial begin
+        force mem[1] = 7;
+        force mem[i] = i;
+        release mem[i];
+        force mem2[i][1] = 1;
+        force s[i].f = 2;
+        release s[1].f;
+        force {mem[0], i} = 0;
+        force bytes[1][3:0] = 4'hf;
+        force dq[1] = 1;
+        release q[1];
+        force nets[i] = 0;
+    end
+endmodule
+)");
+
+    Compilation compilation;
+    compilation.addSyntaxTree(tree);
+
+    auto& diags = compilation.getAllDiagnostics();
+    REQUIRE(diags.size() == 6);
+    CHECK(diags[0].code == diag::BadProceduralForce);
+    CHECK(diags[1].code == diag::DynamicNotProcedural);
+    CHECK(diags[2].code == diag::BadProceduralForce);
+    CHECK(diags[3].code == diag::DynamicNotProcedural);
+    CHECK(diags[4].code == diag::BadProceduralForce);
+    CHECK(diags[5].code == diag::ConstEvalNonConstVariable);
+}
