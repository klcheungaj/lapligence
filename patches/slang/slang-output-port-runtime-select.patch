+// The declared net or variable that a chain of selects and member accesses
+// writes, or null when the chain does not end in a plain value reference
+// (for example a class handle member).
+static const Symbol* selectRootSymbol(const Expression& expr) {
+    const Expression* current = &expr;
+    while (true) {
+        switch (current->kind) {
+            case ExpressionKind::ElementSelect:
+                current = &current->as<ElementSelectExpression>().value();
+                break;
+            case ExpressionKind::RangeSelect:
+                current = &current->as<RangeSelectExpression>().value();
+                break;
+            case ExpressionKind::MemberAccess:
+                current = &current->as<MemberAccessExpression>().value();
+                if (current->type->isObjectHandleType())
+                    return nullptr;
+                break;
+            case ExpressionKind::NamedValue:
+            case ExpressionKind::HierarchicalValue:
+                return &current->as<ValueExpressionBase>().symbol;
+            default:
+                return nullptr;
+        }
+    }
+}
