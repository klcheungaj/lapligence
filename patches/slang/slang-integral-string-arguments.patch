+// Subroutines whose string arguments may also be "an integral data type containing a
+// character string" (SV 21.3.1, 21.7), and $timeformat, whose suffix the text does not
+// restrict: the value converts as by a cast to string.
+static bool acceptsIntegralString(parsing::KnownSystemName name) {
+    using parsing::KnownSystemName;
+    switch (name) {
+        case KnownSystemName::FOpen:
+        case KnownSystemName::TestPlusArgs:
+        case KnownSystemName::TimeFormat:
+        case KnownSystemName::System:
+        case KnownSystemName::DumpFile:
+        case KnownSystemName::DumpPortsOn:
+        case KnownSystemName::DumpPortsOff:
+        case KnownSystemName::DumpPortsAll:
+        case KnownSystemName::DumpPortsLimit:
+        case KnownSystemName::DumpPortsFlush:
+            return true;
+        default:
+            return false;
+    }
+}
