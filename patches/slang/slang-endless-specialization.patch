+// Indicates whether an instance of the given checker encloses the given scope.
+static bool isInInstanceOf(const CheckerSymbol& checker, const Scope& scope) {
+    for (auto curr = &scope; curr; curr = curr->asSymbol().getSpecializingParent()) {
+        auto& sym = curr->asSymbol();
+        if (sym.kind == SymbolKind::CheckerInstanceBody &&
+            &sym.as<CheckerInstanceBodySymbol>().checker == &checker) {
+            return true;
+        }
+    }
+    return false;
+}
