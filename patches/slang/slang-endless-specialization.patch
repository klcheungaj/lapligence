+const Scope* Symbol::getSpecializingParent() const {
+    if (kind == SymbolKind::ClassType) {
+        auto& classType = as<ClassType>();
+        if (classType.specializingScope)
+            return classType.specializingScope;
+    }
+    else if (kind == SymbolKind::InstanceBody) {
+        // The instance is not set yet while the body is being created.
+        auto parentInst = as<InstanceBodySymbol>().parentInstance;
+        return parentInst ? parentInst->getParentScope() : nullptr;
+    }
+    else if (kind == SymbolKind::CheckerInstanceBody) {
+        auto parentInst = as<CheckerInstanceBodySymbol>().parentInstance;
+        return parentInst ? parentInst->getParentScope() : nullptr;
+    }
+    return parentScope;
+}
+
 bool Symbol::isType() const {
