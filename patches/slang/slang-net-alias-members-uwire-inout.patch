+TEST_CASE("uwire inout collapse is not a driver") {
+    // IEEE 1800-2009 23.3.3.6-23.3.3.7: an inout port collapses a uwire with
+    // the net on the other side instead of driving it, so neither an inout
+    // uwire formal nor a (concatenated) uwire actual counts as a driver. The
+    // simulator checks drivers of the collapsed network (6.6.2).
+    auto& code = R"(
+module drv(inout uwire p);
+    assign p = 1'b0;
+endmodule
+
+module pair(inout wire [1:0] p);
+    assign p[1] = 1'b1;
+endmodule
+
+module top;
+    wire w;
+    drv d(w);
+
+    uwire a, b;
+    pair u({a, b});
+    assign b = 1'b0;
+endmodule
+)";
+
+    Compilation compilation;
+    AnalysisManager analysisManager;
+
+    auto diags = analyze(code, compilation, analysisManager);
+    CHECK(std::ranges::none_of(diags, [](auto& d) {
+        return d.code == diag::MultipleUWireDrivers;
+    }));
+}
+
+TEST_CASE("uwire inout formal keeps local single driver") {
+    auto& code = R"(
+module drv(inout uwire p);
+    assign p = 1'b0;
+    assign p = 1'b1;
+endmodule
+
+module top;
+    wire w;
+    drv d(w);
+endmodule
+)";
+
+    Compilation compilation;
+    AnalysisManager analysisManager;
+
+    auto diags = analyze(code, compilation, analysisManager);
+    CHECK(std::ranges::count_if(diags, [](auto& d) {
+              return d.code == diag::MultipleUWireDrivers;
+          }) == 1);
+}
+
