+static bool isUWireNet(const Symbol* sym) {
+    return sym && sym->kind == SymbolKind::Net &&
+           sym->as<NetSymbol>().netType.netKind == NetType::UWire;
+}
+
+// An inout connection collapses a uwire with the net on the other side of the
+// port instead of driving it (IEEE 1800-2009 23.3.3.6-23.3.3.7); the simulator
+// counts the drivers of the collapsed network for the 6.6.2 single-driver
+// rule. Concatenations are split so that only their uwire operands are exempt
+// and every other operand stays a driver.
+template<typename F>
+static void visitInOutDriven(const Expression& expr, F&& addOperand) {
+    const Expression* current = &expr;
+    while (current->kind == ExpressionKind::Conversion &&
+           current->as<ConversionExpression>().isImplicit()) {
+        current = &current->as<ConversionExpression>().operand();
+    }
+
+    if (current->kind == ExpressionKind::Concatenation) {
+        for (auto operand : current->as<ConcatenationExpression>().operands())
+            visitInOutDriven(*operand, addOperand);
+        return;
+    }
+
+    if (!isUWireNet(current->getSymbolReference()))
+        addOperand(*current);
+}
