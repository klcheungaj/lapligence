+// A gate or UDP output terminal is a net_lvalue (IEEE 1800-2009 A.3.3,
+// A.8.5) whose selects stay constant even when it names a variable; the
+// runtime variable_lvalue select of a module output port (23.3.3.2) does not
+// apply. Evaluating each selector reports a non-constant one.
+static bool requireConstantTerminalSelects(const Expression& expr, const ASTContext& context) {
+    switch (expr.kind) {
+        case ExpressionKind::Assignment:
+            return requireConstantTerminalSelects(expr.as<AssignmentExpression>().left(),
+                                                  context);
+        case ExpressionKind::Conversion:
+            return requireConstantTerminalSelects(expr.as<ConversionExpression>().operand(),
+                                                  context);
+        case ExpressionKind::Concatenation:
+            for (auto operand : expr.as<ConcatenationExpression>().operands()) {
+                if (!requireConstantTerminalSelects(*operand, context))
+                    return false;
+            }
+            return true;
+        case ExpressionKind::MemberAccess:
+            return requireConstantTerminalSelects(expr.as<MemberAccessExpression>().value(),
+                                                  context);
+        case ExpressionKind::ElementSelect: {
+            auto& select = expr.as<ElementSelectExpression>();
+            return requireConstantTerminalSelects(select.value(), context) &&
+                   context.eval(select.selector());
+        }
+        case ExpressionKind::RangeSelect: {
+            auto& select = expr.as<RangeSelectExpression>();
+            return requireConstantTerminalSelects(select.value(), context) &&
+                   context.eval(select.left()) && context.eval(select.right());
+        }
+        default:
+            return true;
+    }
+}
