+// A net_lvalue's constant_select may name members of a structure net
+// (IEEE 1800-2009 10.11, A.8.3 and A.8.5), so selects and member accesses
+// are traced to the referenced net rather than to the member itself.
+static const Expression& aliasRootExpression(const Expression& expr) {
+    const Expression* current = &expr;
+    while (true) {
+        switch (current->kind) {
+            case ExpressionKind::ElementSelect:
+                current = &current->as<ElementSelectExpression>().value();
+                break;
+            case ExpressionKind::RangeSelect:
+                current = &current->as<RangeSelectExpression>().value();
+                break;
+            case ExpressionKind::MemberAccess:
+                current = &current->as<MemberAccessExpression>().value();
+                break;
+            default:
+                return *current;
+        }
+    }
+}
