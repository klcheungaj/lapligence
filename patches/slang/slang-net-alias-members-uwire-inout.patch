     if (expr->kind == ExpressionKind::Assignment)
         expr = &expr->as<AssignmentExpression>().left();
 
+    // An inout connection collapses a uwire with the internal net instead of
+    // driving it (IEEE 1800-2009 23.3.3.6-23.3.3.7); the simulator counts the
+    // drivers of the collapsed network for the 6.6.2 single-driver rule.
+    if (direction == ArgumentDirection::InOut) {
+        auto sym = expr->getSymbolReference();
+        if (sym && sym->kind == SymbolKind::Net &&
+            sym->as<NetSymbol>().netType.netKind == NetType::UWire) {
+            return;
+        }
+    }
+
     addDrivers(context, driverAlloc, *expr, DriverKind::Continuous, flags, containingSymbol);
 }
 
