+TEST_CASE("Conditional merge turns equal Z branch bits into X") {
+    auto tree = SyntaxTree::fromText(R"(
+module m;
+    localparam logic p = 1'bx ? 1'bz : 1'bz;
+    localparam logic [7:0] q = 1'bx ? 8'b10zz01x0 : 8'b10zz01x0;
+endmodule
+)");
+
+    Compilation compilation;
+    compilation.addSyntaxTree(tree);
+    NO_COMPILATION_ERRORS;
+
+    auto& root = compilation.getRoot();
+    auto& p = root.lookupName<ParameterSymbol>("m.p");
+    CHECK(exactlyEqual(p.getValue().integer(), "1'bx"_si));
+    auto& q = root.lookupName<ParameterSymbol>("m.q");
+    CHECK(exactlyEqual(q.getValue().integer(), "8'b10xx01x0"_si));
+}
+
+TEST_CASE("Conditional known-one predicate retains a selected Z arm") {
+    auto tree = SyntaxTree::fromText(R"(
+module m;
+    localparam logic [128:0] p = 4'b1xz0 ? {129{1'bz}} : 129'b0;
+    localparam logic [7:0] q = 4'b0xz0 ? 8'bzzzz0000 : 8'bzzzz0000;
+    function automatic logic chosen();
+        int calls = 0;
+        logic value;
+        value = 4'b1xz0 ? 1'bz : (calls++ == 0);
+        return (calls == 0) && (value === 1'bz);
+    endfunction
+    localparam logic only_true_arm = chosen();
+endmodule
+)");
+
+    Compilation compilation;
+    compilation.addSyntaxTree(tree);
+    NO_COMPILATION_ERRORS;
+    auto& root = compilation.getRoot();
+    auto& p = root.lookupName<ParameterSymbol>("m.p");
+    CHECK(p.getValue().integer().countZs() == 129);
+    auto& q = root.lookupName<ParameterSymbol>("m.q");
+    CHECK(exactlyEqual(q.getValue().integer(), "8'bxxxx0000"_si));
+    auto& selected = root.lookupName<ParameterSymbol>("m.only_true_arm");
+    CHECK(selected.getValue().integer() == 1);
+}
+
+TEST_CASE("Unpacked conditional constants merge immediate member type defaults") {
+    auto tree = SyntaxTree::fromText(R"(
+module m;
+    typedef struct {
+        logic [7:0] changed = 8'h11;
+        bit flag = 1;
+        logic [7:0] equal_value = 8'h22;
+        logic [7:0] row[2] = '{8'h10, 8'h11};
+    } S;
+    localparam S a = '{8'ha5, 1, 8'h5a, '{8'h10, 8'h11}};
+    localparam S b = '{8'ha6, 0, 8'h5a, '{8'h10, 8'h12}};
+    localparam S r = 1'bx ? a : b;
+    localparam S known = 4'b1xz0 ? a : b;
+    typedef struct { S child; logic [7:0] equal_value; } T;
+    localparam T ta = '{a, 8'hc3};
+    localparam T tb = '{b, 8'hc3};
+    localparam T tr = 1'bz ? ta : tb;
+endmodule
+)");
+
+    Compilation compilation;
+    compilation.addSyntaxTree(tree);
+    NO_COMPILATION_ERRORS;
+    auto& root = compilation.getRoot();
+    auto r = root.lookupName<ParameterSymbol>("m.r").getValue().elements();
+    CHECK(exactlyEqual(r[0].integer(), "8'hxx"_si));
+    CHECK(r[1].integer() == 0);
+    CHECK(r[2].integer() == 0x5a);
+    CHECK(exactlyEqual(r[3].elements()[0].integer(), "8'hxx"_si));
+    CHECK(exactlyEqual(r[3].elements()[1].integer(), "8'hxx"_si));
+    auto known = root.lookupName<ParameterSymbol>("m.known").getValue().elements();
+    CHECK(known[0].integer() == 0xa5);
+    CHECK(known[1].integer() == 1);
+    auto nested = root.lookupName<ParameterSymbol>("m.tr").getValue().elements();
+    CHECK(nested[0].elements()[1].integer() == 0);
+    CHECK(exactlyEqual(nested[0].elements()[2].integer(), "8'hxx"_si));
+    CHECK(nested[1].integer() == 0xc3);
+}
