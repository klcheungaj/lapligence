+TEST_CASE("Conditional merge turns equal Z branch bits into X") {
+    auto tree = SyntaxTree::fromText(R"(
+module m;
+    localparam logic p = 1'bx ? 1'bz : 1'bz;
+    localparam logic [7:0] q = 1'bx ? 8'b10zz01x0 : 8'b10zz01x0;
+endmodule
+)");
+
+    Compilation compilation;
+    compilation.addSyntaxTree(tree);
+    NO_COMPILATION_ERRORS;
+
+    auto& root = compilation.getRoot();
+    auto& p = root.lookupName<ParameterSymbol>("m.p");
+    CHECK(exactlyEqual(p.getValue().integer(), "1'bx"_si));
+    auto& q = root.lookupName<ParameterSymbol>("m.q");
+    CHECK(exactlyEqual(q.getValue().integer(), "8'b10xx01x0"_si));
+}
+
+TEST_CASE("Conditional known-one predicate retains a selected Z arm") {
+    auto tree = SyntaxTree::fromText(R"(
+module m;
+    localparam logic [128:0] p = 4'b1xz0 ? {129{1'bz}} : 129'b0;
+    localparam logic [7:0] q = 4'b0xz0 ? 8'bzzzz0000 : 8'bzzzz0000;
+    function automatic logic chosen();
+        int calls = 0;
+        logic value;
+        value = 4'b1xz0 ? 1'bz : (calls++ == 0);
+        return (calls == 0) && (value === 1'bz);
+    endfunction
+    localparam logic only_true_arm = chosen();
+endmodule
+)");
+
+    Compilation compilation;
+    compilation.addSyntaxTree(tree);
+    NO_COMPILATION_ERRORS;
+    auto& root = compilation.getRoot();
+    auto& p = root.lookupName<ParameterSymbol>("m.p");
+    CHECK(p.getValue().integer().countZs() == 129);
+    auto& q = root.lookupName<ParameterSymbol>("m.q");
+    CHECK(exactlyEqual(q.getValue().integer(), "8'bxxxx0000"_si));
+    auto& selected = root.lookupName<ParameterSymbol>("m.only_true_arm");
+    CHECK(selected.getValue().integer() == 1);
+}
