+// Finds how many specializations of the given class enclose the given scope: the
+// body of a specialization lies in the scope that names the specialization.
+static uint32_t findSpecializationDepth(const GenericClassDefSymbol& genericClass,
+                                        const Scope& scope) {
+    for (auto curr = &scope; curr;) {
+        auto& sym = curr->asSymbol();
+        if (sym.kind == SymbolKind::ClassType) {
+            auto& classType = sym.as<ClassType>();
+            if (classType.genericClass == &genericClass)
+                return classType.specializationDepth + 1;
+        }
+        curr = sym.getSpecializingParent();
+    }
+    return 0;
