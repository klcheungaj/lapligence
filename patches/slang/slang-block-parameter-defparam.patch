+// Whether a defparam can reach a parameter of the given procedural scope: one of an instance,
+// through blocks, subroutines and generate blocks only.
+static bool isInstanceProcedure(const Scope* scope) {
+    for (; scope; scope = scope->asSymbol().getParentScope()) {
+        switch (scope->asSymbol().kind) {
+            case SymbolKind::InstanceBody:
+                return true;
+            case SymbolKind::StatementBlock:
+            case SymbolKind::Subroutine:
+            case SymbolKind::GenerateBlock:
+            case SymbolKind::GenerateBlockArray:
+                break;
+            default:
+                return false;
+        }
+    }
+    return false;
+}
+
+const ConstantValue* ParameterSymbol::findBlockOverride() const {
+    // The parameters of an instance itself take their overrides when they are built.
+    auto scope = getParentScope();
+    auto syntax = getSyntax();
+    if (isLocalParam() || !scope || !syntax ||
+        scope->asSymbol().kind == SymbolKind::InstanceBody || !isInstanceProcedure(scope)) {
+        return nullptr;
+    }
+
+    auto node = findParentOverrideNode(*scope);
+    if (!node)
+        return nullptr;
+
+    auto it = node->paramOverrides.find(syntax);
+    return it == node->paramOverrides.end() ? nullptr : &it->second.cv;
 }
 
