+OpaqueInstancePath OpaqueInstancePath::toParameterScope(const Symbol& parameter) {
+    auto curr = &parameter;
+    while (curr->kind != SymbolKind::InstanceBody && curr->kind != SymbolKind::GenerateBlock) {
+        auto parent = curr->getHierarchicalParent();
+        if (!parent)
+            return {};
+
+        curr = &parent->asSymbol();
+    }
+
+    OpaqueInstancePath result;
+    result.buildPath(*curr);
+    return result;
+}
