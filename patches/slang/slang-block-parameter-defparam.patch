+
+// Whether a defparam can reach a parameter of the given procedural scope: one of an instance,
+// through blocks, subroutines and generate blocks only.
+static bool isInstanceProcedure(const Scope* scope) {
+    for (; scope; scope = scope->asSymbol().getParentScope()) {
+        switch (scope->asSymbol().kind) {
+            case SymbolKind::InstanceBody:
+                return true;
+            case SymbolKind::StatementBlock:
+            case SymbolKind::Subroutine:
+            case SymbolKind::GenerateBlock:
+            case SymbolKind::GenerateBlockArray:
+                break;
+            default:
+                return false;
+        }
+    }
+    return false;
+}
+
+// The override that a defparam gives the parameter, if any. Config overrides take precedence.
+static const HierarchyOverrideNode::ParamOverride* findDefparam(const ParameterSymbol& param) {
+    auto scope = param.getParentScope();
+    auto syntax = param.getSyntax();
+    if (param.isLocalParam() || param.isFromConfig() || !scope || !syntax || !isInstanceProcedure(scope))
+        return nullptr;
+
+    auto node = findParentOverrideNode(*scope);
+    if (!node)
+        return nullptr;
+
+    auto it = node->paramOverrides.find(syntax);
+    if (it == node->paramOverrides.end() || !it->second.defparam)
+        return nullptr;
+
+    return &it->second;
+}
+
+const ConstantValue* ParameterSymbol::findBlockOverride() const {
+    // The parameters of an instance itself take their overrides when they are built.
+    auto scope = getParentScope();
+    if (!scope || scope->asSymbol().kind == SymbolKind::InstanceBody)
+        return nullptr;
+
+    auto defparam = findDefparam(*this);
+    return defparam ? &defparam->cv : nullptr;
+}
+
+const Type* ParameterSymbol::getDefparamType() const {
+    auto typeSyntax = getDeclaredType()->getTypeSyntax();
+    if (!typeSyntax || typeSyntax->kind != SyntaxKind::ImplicitType ||
+        !typeSyntax->as<ImplicitTypeSyntax>().dimensions.empty()) {
+        return nullptr;
+    }
+
+    auto defparam = findDefparam(*this);
+    if (!defparam)
+        return nullptr;
+
+    // The value was converted to its final type where the defparam was bound.
+    auto& comp = getParentScope()->getCompilation();
+    auto& cv = defparam->cv;
+    if (cv.isInteger()) {
+        bitmask<IntegralFlags> flags = IntegralFlags::FourState;
+        if (cv.integer().isSigned())
+            flags |= IntegralFlags::Signed;
+
+        return &comp.getType(cv.integer().getBitWidth(), flags);
+    }
+
+    if (cv.isReal())
+        return &comp.getRealType();
+
+    if (cv.isShortReal())
+        return &comp.getShortRealType();
+
+    if (cv.isString())
+        return &comp.getStringType();
+
+    return nullptr;
 }
 
