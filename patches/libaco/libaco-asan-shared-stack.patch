--- a/aco.c
+++ b/aco.c
@@ -17,6 +17,9 @@
 #include "aco.h"
 #include <stdio.h>
 #include <stdint.h>
+#ifdef ACO_USE_ASAN
+#include <sanitizer/asan_interface.h>
+#endif
 
 // this header including should be at the last of the `include` directives list
 #include "aco_assert_override.h"
@@ -42,6 +45,46 @@ void aco_runtime_test(void){
 // assert((((sz) & 0x0f) == 0x08) && (((sz) >> 4) >= 0) && (((sz) >> 4) <= 8));
 // sz = 16*n + 8 ( 0 <= n <= 8)
 
+// Suspended stacks contain ASan redzones; libc memcpy interceptors still check
+// them inside no_sanitize_address functions. Volatile bytes prevent the compiler
+// from turning this sanitizer-only copy back into an intercepted memcpy call.
+aco_attr_no_asan
+static void aco_stack_memcpy(void* dst, const void* src, size_t sz){
+#ifdef ACO_USE_ASAN
+    volatile unsigned char* to = (volatile unsigned char*)dst;
+    const volatile unsigned char* from = (const volatile unsigned char*)src;
+    for(size_t i = 0; i < sz; i++){
+        to[i] = from[i];
+    }
+#else
+    memcpy(dst, src, sz);
+#endif
+}
+
+#ifdef ACO_USE_ASAN
+aco_attr_no_asan
+static void aco_asan_shadow(aco_t* co, int save){
+    size_t scale, offset;
+    __asan_get_shadow_mapping(&scale, &offset);
+    uintptr_t low = (uintptr_t)co->reg[ACO_REG_IDX_SP] >> scale;
+    uintptr_t high = (uintptr_t)co->share_stack->align_highptr >> scale;
+    size_t sz = high - low;
+    void* shadow = (void*)(low + offset);
+    if(save){
+        if(co->save_stack.asan_shadow_sz < sz){
+            free(co->save_stack.asan_shadow);
+            co->save_stack.asan_shadow = malloc(sz);
+            assertalloc_ptr(co->save_stack.asan_shadow);
+            co->save_stack.asan_shadow_sz = sz;
+        }
+        aco_stack_memcpy(co->save_stack.asan_shadow, shadow, sz);
+    }else{
+        assert(co->save_stack.asan_shadow_sz >= sz);
+        aco_stack_memcpy(shadow, co->save_stack.asan_shadow, sz);
+    }
+}
+#endif
+
 // Note: dst and src must be valid address already
 #define aco_amd64_inline_short_aligned_memcpy_test_ok(dst, src, sz) \
     (   \
@@ -152,7 +195,7 @@ void aco_runtime_test(void){
     if(aco_amd64_inline_short_aligned_memcpy_test_ok((dst), (src), (sz))){ \
         aco_amd64_inline_short_aligned_memcpy((dst), (src), (sz)); \
     }else{ \
-        memcpy((dst), (src), (sz)); \
+        aco_stack_memcpy((dst), (src), (sz)); \
     } \
 } while(0)
 
@@ -249,8 +292,14 @@ aco_share_stack_t* aco_share_stack_new2(size_t sz, char guard_page_enabled){
     memset(p, 0, sizeof(aco_share_stack_t));
 
     if(guard_page_enabled != 0){
+        int map_flags = MAP_PRIVATE|MAP_ANONYMOUS;
+#if defined(__linux__) && defined(MAP_NORESERVE)
+        // Model-sized stacks reserve conservative virtual headroom. Commit
+        // physical pages as used, without reserving swap for the entire range.
+        map_flags |= MAP_NORESERVE;
+#endif
         p->real_ptr = mmap(
-            NULL, sz, PROT_READ|PROT_WRITE, MAP_PRIVATE|MAP_ANONYMOUS, -1, 0
+            NULL, sz, PROT_READ|PROT_WRITE, map_flags, -1, 0
         );
         assertalloc_bool(p->real_ptr != MAP_FAILED);
         p->guard_page_enabled = 1;
@@ -277,6 +326,9 @@ aco_share_stack_t* aco_share_stack_new2(size_t sz, char guard_page_enabled){
     uintptr_t u_p = (uintptr_t)(p->sz - (sizeof(void*) << 1) + (uintptr_t)p->ptr);
     u_p = (u_p >> 4) << 4;
     p->align_highptr = (void*)u_p;
+#ifdef ACO_USE_ASAN
+    p->asan_low = p->align_highptr;
+#endif
     p->align_retptr  = (void*)(u_p - sizeof(void*));
     *((void**)(p->align_retptr)) = (void*)(aco_funcp_protector_asm);
     assert(p->sz > (16 + (sizeof(void*) << 1) + sizeof(void*)));
@@ -389,6 +441,9 @@ void aco_resume(aco_t* resume_co){
                 (uintptr_t)(owner_co->share_stack->align_retptr)
                 -
                 (uintptr_t)(owner_co->reg[ACO_REG_IDX_SP]);
+#ifdef ACO_USE_ASAN
+            aco_asan_shadow(owner_co, 1);
+#endif
             if(owner_co->save_stack.sz < owner_co->save_stack.valid_sz){
                 free(owner_co->save_stack.ptr);
                 owner_co->save_stack.ptr = NULL;
@@ -412,7 +467,7 @@ void aco_resume(aco_t* resume_co){
                     owner_co->save_stack.valid_sz
                 );
     #else
-                memcpy(
+                aco_stack_memcpy(
                     owner_co->save_stack.ptr,
                     owner_co->reg[ACO_REG_IDX_SP],
                     owner_co->save_stack.valid_sz
@@ -430,6 +485,18 @@ void aco_resume(aco_t* resume_co){
 #endif
         }
         assert(resume_co->share_stack->owner == NULL);
+#ifdef ACO_USE_ASAN
+        // A different coroutine can place locals where the previous one had
+        // redzones. Restore its shadow with its bytes, preserving ASan checks.
+        __asan_unpoison_memory_region(
+            resume_co->share_stack->asan_low,
+            (uintptr_t)resume_co->share_stack->align_highptr
+                - (uintptr_t)resume_co->share_stack->asan_low
+        );
+        if(resume_co->save_stack.valid_sz > 0){
+            aco_asan_shadow(resume_co, 0);
+        }
+#endif
 #if defined(__i386__) || defined(__x86_64__)
         assert(
             resume_co->save_stack.valid_sz
@@ -450,7 +517,7 @@ void aco_resume(aco_t* resume_co){
                 resume_co->save_stack.valid_sz
             );
     #else
-            memcpy(
+            aco_stack_memcpy(
                 (void*)(
                     (uintptr_t)(resume_co->share_stack->align_retptr)
                     -
@@ -473,6 +540,9 @@ void aco_resume(aco_t* resume_co){
     }
     aco_gtls_co = resume_co;
     acosw(resume_co->main_co, resume_co);
+#ifdef ACO_USE_ASAN
+    resume_co->share_stack->asan_low = resume_co->reg[ACO_REG_IDX_SP];
+#endif
     aco_gtls_co = resume_co->main_co;
 }
 
@@ -486,6 +556,9 @@ void aco_destroy(aco_t* co){
             co->share_stack->align_validsz = 0;
         }
         free(co->save_stack.ptr);
+#ifdef ACO_USE_ASAN
+        free(co->save_stack.asan_shadow);
+#endif
         co->save_stack.ptr = NULL;
         free(co);
     }
