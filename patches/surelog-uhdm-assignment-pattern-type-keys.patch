+      result.ranges.emplace_back(31, 0);
+      return true;
+    case UHDM_OBJECT_TYPE::uhdmlong_int_typespec:
+      result.leaf = UHDM_OBJECT_TYPE::uhdmbit_typespec;
+      result.isSigned = ((const long_int_typespec*)type)->VpiSigned();
+      result.ranges.emplace_back(63, 0);
+      return true;
+    case UHDM_OBJECT_TYPE::uhdminteger_typespec:
+      result.leaf = UHDM_OBJECT_TYPE::uhdmlogic_typespec;
+      result.isSigned = ((const integer_typespec*)type)->VpiSigned();
+      result.ranges.emplace_back(31, 0);
+      return true;
+    case UHDM_OBJECT_TYPE::uhdmtime_typespec:
+      result.leaf = UHDM_OBJECT_TYPE::uhdmlogic_typespec;
+      result.isSigned = ((const time_typespec*)type)->VpiSigned();
