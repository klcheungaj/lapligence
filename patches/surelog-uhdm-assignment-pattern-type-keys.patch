+static bool assignmentPatternPackedType(ExprEval& eval, const typespec* type,
+                                        AssignmentPatternPackedType& result,
+                                        uint32_t depth = 0) {
+  if ((type == nullptr) || (depth == 64)) return false;
+  auto appendRanges = [&](const VectorOfrange* ranges) {
+    if (ranges == nullptr) return true;
+    for (const range* dimension : *ranges) {
+      bool invalid = false;
+      const int64_t left = eval.get_value(invalid, dimension->Left_expr());
+      if (invalid) return false;
+      const int64_t right = eval.get_value(invalid, dimension->Right_expr());
+      if (invalid) return false;
+      result.ranges.emplace_back(left, right);
+    }
+    return true;
+  };
+  switch (type->UhdmType()) {
+    case UHDM_OBJECT_TYPE::uhdmpacked_array_typespec: {
+      const auto* array = (const packed_array_typespec*)type;
+      const ref_typespec* element = array->Elem_typespec();
+      return appendRanges(array->Ranges()) && (element != nullptr) &&
+             assignmentPatternPackedType(eval, element->Actual_typespec(),
+                                         result, depth + 1);
+    }
+    case UHDM_OBJECT_TYPE::uhdmlogic_typespec: {
+      const auto* logic = (const logic_typespec*)type;
+      result.leaf = type->UhdmType();
+      result.isSigned = logic->VpiSigned();
+      if (!appendRanges(logic->Ranges())) return false;
+      if (result.ranges.empty()) result.ranges.emplace_back(0, 0);
+      return true;
+    }
+    case UHDM_OBJECT_TYPE::uhdmbit_typespec: {
+      const auto* bit = (const bit_typespec*)type;
+      result.leaf = type->UhdmType();
+      result.isSigned = bit->VpiSigned();
+      if (!appendRanges(bit->Ranges())) return false;
+      if (result.ranges.empty()) result.ranges.emplace_back(0, 0);
+      return true;
+    }
+    case UHDM_OBJECT_TYPE::uhdmbyte_typespec:
+      result.leaf = UHDM_OBJECT_TYPE::uhdmbit_typespec;
+      result.isSigned = ((const byte_typespec*)type)->VpiSigned();
+      result.ranges.emplace_back(7, 0);
+      return true;
+    case UHDM_OBJECT_TYPE::uhdmshort_int_typespec:
