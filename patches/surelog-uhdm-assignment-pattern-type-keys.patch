+// IEEE 1800-2009 6.22.1 and 10.9 require matching types, not merely typespec
+// object kinds. Follow simple typedef aliases, preserve exact packed ranges,
+// state domain, and signedness, and keep aggregate typedef identity nominal.
+static bool assignmentPatternTypesMatch(ExprEval& eval, const typespec* lhs,
+                                        const typespec* rhs,
+                                        uint32_t depth = 0) {
+  if ((lhs == nullptr) || (rhs == nullptr)) return lhs == rhs;
+  if (lhs == rhs) return true;
+  if (depth == 64) return false;
+  AssignmentPatternPackedType lhsPacked;
+  AssignmentPatternPackedType rhsPacked;
+  if (assignmentPatternPackedType(eval, lhs, lhsPacked) &&
+      assignmentPatternPackedType(eval, rhs, rhsPacked)) {
+    return (lhsPacked.leaf == rhsPacked.leaf) &&
+           (lhsPacked.isSigned == rhsPacked.isSigned) &&
+           (lhsPacked.ranges == rhsPacked.ranges);
+  }
+  if (const ref_typespec* alias = lhs->Typedef_alias()) {
+    if (const typespec* actual = alias->Actual_typespec()) {
+      if (actual != lhs) {
+        return assignmentPatternTypesMatch(eval, actual, rhs, depth + 1);
+      }
+    }
+  }
+  if (const ref_typespec* alias = rhs->Typedef_alias()) {
+    if (const typespec* actual = alias->Actual_typespec()) {
+      if (actual != rhs) {
+        return assignmentPatternTypesMatch(eval, lhs, actual, depth + 1);
+      }
+    }
+  }
+  if (lhs->UhdmType() != rhs->UhdmType()) return false;
+  switch (lhs->UhdmType()) {
+    case UHDM_OBJECT_TYPE::uhdmenum_typespec:
+    case UHDM_OBJECT_TYPE::uhdmstruct_typespec:
+    case UHDM_OBJECT_TYPE::uhdmunion_typespec:
+    case UHDM_OBJECT_TYPE::uhdmclass_typespec:
+      return false;
+    case UHDM_OBJECT_TYPE::uhdmreal_typespec:
+    case UHDM_OBJECT_TYPE::uhdmshort_real_typespec:
+    case UHDM_OBJECT_TYPE::uhdmstring_typespec:
+    case UHDM_OBJECT_TYPE::uhdmchandle_typespec:
+      return true;
+    default:
+      return false;
+  }
+}
