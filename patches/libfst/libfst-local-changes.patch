+ * lapligence: name a failed fstWriterCreate step on stderr. Call it directly
+ * after the failed open, while errno and _doserrno still describe that open.
+ * The non-Windows temporary files have no name.
+ */
+static void fstWriterCreateOpenFailed(const char *step, const char *path)
+{
+int err = errno;
+#ifdef FST_WIN32_API
+unsigned long oserr = _doserrno;
+
+fprintf(stderr, FST_APIMESS "fstWriterCreate: cannot open %s `%s`: %s (errno %d, _doserrno %lu)\n",
+        step, path ? path : "(unnamed)", strerror(err), err, oserr);
+#else
+fprintf(stderr, FST_APIMESS "fstWriterCreate: cannot open %s `%s`: %s (errno %d)\n",
+        step, path ? path : "(unnamed)", strerror(err), err);
+#endif
+}
